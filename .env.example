# ==============================================================================
# CONTACT FORM CONFIGURATION
# ==============================================================================

# Destination inbox where messages should be sent (defaults to daniel@upbynature.com if omitted)
CONTACT_EMAIL=daniel@upbynature.com

# OPTION 1: Resend (Recommended - 100 free emails/day)
# 1. Sign up free at https://resend.com
# 2. Generate an API Key under "API Keys"
# 3. Paste the key below:
RESEND_API_KEY=re_1234567890abcdef

# (Optional) Verified sender email if you have your custom domain added to Resend.
# Leave commented out or unset to use the default onboarding address during testing.
# RESEND_FROM=Daniel <contact@upbynature.com>


# OPTION 2: Formspree (Alternative free option)
# 1. Create a form at https://formspree.io
# 2. Copy your form ID (e.g. "xpznvgqe")
# FORMSPREE_KEY=xpznvgqe
